{
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/pizza",
      "destination": "https://cenlofood.cenlo.pt/",
      "permanent": true
    },
    {
      "source": "/food",
      "destination": "https://cenlofood.cenlo.pt/",
      "permanent": false
    },
    {
      "source": "/beauty",
      "destination": "https://cenlobeauty.cenlo.pt/",
      "permanent": false
    },
    {
      "source": "/pedro",
      "destination": "https://pedro.cenlo.pt",
      "permanent": false
    },
    {
      "source": "/contato",
      "destination": "https://pedro.cenlo.pt",
      "permanent": false
    },
    {
      "source": "/food/montar",
      "destination": "https://cenlofood.cenlo.pt/configurar",
      "permanent": false
    },
    {
      "source": "/food/montar/:path*",
      "destination": "https://cenlofood.cenlo.pt/configurar/:path*",
      "permanent": false
    }
  ]
}
